{
  "name": "zhck-meeting-frontend",
  "version": "1.0.0",
  "description": "50人视频会议前端应用",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
